{
	"name": "elemental",
	"version": "0.0.0",
	"private": true,
	"bin": {
		"elemental": "./dist/cli.js"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./dist/index.js"
		},
		"./oxlint-plugin": "./oxlint-elemental-plugin.js",
		"./package.json": "./package.json"
	},
	"scripts": {
		"bench": "node --experimental-strip-types ./bench.ts",
		"build": "node --experimental-strip-types ./src/cli/index.ts build",
		"dev": "node --experimental-strip-types ./src/cli/index.ts dev",
		"format": "oxfmt .",
		"format:check": "oxfmt --check .",
		"lint": "oxlint .",
		"lint:fix": "oxlint --fix .",
		"start": "node dist/server.js",
		"test": "vitest run && playwright test",
		"test:unit": "vitest run",
		"test:e2e": "playwright test",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@playwright/test": "1.60.0",
		"@types/node": "25.8.0",
		"esbuild": "0.28.0",
		"oxc-parser": "0.131.0",
		"oxfmt": "0.50.0",
		"oxlint": "1.65.0",
		"oxlint-tsgolint": "0.22.1",
		"typescript": "6.0.3",
		"vitest": "4.1.6"
	},
	"engines": {
		"node": ">=24 <25"
	}
}
